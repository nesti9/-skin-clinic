<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ю Skin Clinic — Эстетическая косметология в Барнауле</title>
<meta name="description" content="Клиника эстетической и аппаратной косметологии в Барнауле. Индивидуальные протоколы лечения кожи. Запись на процедуры онлайн.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Manrope:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --white: #FFFFFF;
    --milk: #FAF8F5;
    --beige: #F2EDE6;
    --grey-cold: #E8E9EB;
    --grey-mid: #C4C4C4;
    --grey-text: #8A8A8A;
    --graphite: #2A2A2A;
    --graphite-soft: #3D3D3D;
    --gold: #C9A96E;
    --gold-light: #E8D5B0;
    --gold-pale: #F7F0E4;
    --shadow-soft: 0 2px 24px rgba(0,0,0,0.06);
    --shadow-card: 0 4px 32px rgba(0,0,0,0.08);
    --radius: 2px;
    --radius-lg: 4px;
  }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Manrope', sans-serif;
    background: var(--white);
    color: var(--graphite);
    font-size: 15px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  /* HEADER */
  header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(201,169,110,0.15);
    transition: box-shadow .3s;
  }
  header.scrolled { box-shadow: 0 2px 20px rgba(0,0,0,0.07); }
  .header-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
    height: 68px; display: flex; align-items: center;
    justify-content: space-between; gap: 16px;
  }
  .logo { display: flex; flex-direction: column; line-height: 1; text-decoration: none; }
  .logo-main { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 400; letter-spacing: 0.08em; color: var(--graphite); }
  .logo-sub { font-size: 9px; letter-spacing: 0.25em; color: var(--gold); text-transform: uppercase; font-weight: 500; margin-top: 2px; }
  nav { display: flex; gap: 28px; align-items: center; }
  nav a { text-decoration: none; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--graphite-soft); font-weight: 500; transition: color .2s; }
  nav a:hover { color: var(--gold); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-family: 'Manrope', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none;
    cursor: pointer; border: none; transition: all .25s;
    padding: 13px 28px; border-radius: var(--radius);
  }
  .btn-gold { background: var(--graphite); color: var(--white); }
  .btn-gold:hover { background: var(--gold); }
  .btn-outline { background: transparent; color: var(--graphite); border: 1px solid rgba(42,42,42,0.3); }
  .btn-outline:hover { border-color: var(--gold); color: var(--gold); }
  .nav-cta { padding: 10px 22px; font-size: 10px; }
  .burger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
  .burger span { display: block; width: 22px; height: 1.5px; background: var(--graphite); margin: 5px 0; transition: all .3s; }

  /* MOBILE MENU */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 99;
    background: var(--white);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 28px;
    transform: translateX(100%); transition: transform .35s cubic-bezier(.4,0,.2,1);
  }
  .mobile-menu.open { transform: translateX(0); }
  .mobile-menu a { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 300; color: var(--graphite); text-decoration: none; letter-spacing: 0.05em; transition: color .2s; }
  .mobile-menu a:hover { color: var(--gold); }
  .mobile-menu .btn { font-family: 'Manrope', sans-serif; font-size: 11px; }

  /* HERO */
  .hero {
    min-height: 100vh; display: flex; flex-direction: column;
    justify-content: flex-end; padding-top: 68px;
    position: relative; overflow: hidden; background: var(--milk);
  }
  .hero-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 75% 40%, rgba(201,169,110,0.08) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 20% 80%, rgba(201,169,110,0.05) 0%, transparent 60%);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(201,169,110,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(201,169,110,0.06) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 100%);
  }
  .hero-inner {
    max-width: 1200px; margin: 0 auto;
    padding: 80px 24px 100px; position: relative; z-index: 2;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end;
  }
  .hero-label {
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); font-weight: 600; margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .hero-label::before { content: ''; display: block; width: 32px; height: 1px; background: var(--gold); }
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(52px, 7vw, 88px); font-weight: 300;
    line-height: 1.05; color: var(--graphite); margin-bottom: 24px;
  }
  .hero-title em { font-style: italic; color: var(--gold); }
  .hero-desc { font-size: 15px; color: var(--grey-text); line-height: 1.8; max-width: 420px; margin-bottom: 40px; font-weight: 300; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-right { display: flex; flex-direction: column; gap: 16px; align-self: center; }
  .hero-stat-card {
    background: rgba(255,255,255,0.85); backdrop-filter: blur(8px);
    border: 1px solid rgba(201,169,110,0.2);
    padding: 22px 26px; border-radius: var(--radius-lg); box-shadow: var(--shadow-soft);
  }
  .stat-num { font-family: 'Cormorant Garamond', serif; font-size: 42px; font-weight: 300; color: var(--graphite); line-height: 1; margin-bottom: 4px; }
  .stat-num span { color: var(--gold); }
  .stat-label { font-size: 12px; color: var(--grey-text); }
  .hero-stats-row { display: flex; gap: 16px; }
  .hero-stats-row .hero-stat-card { flex: 1; }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; color: var(--graphite-soft); letter-spacing: 0.05em;
    padding: 8px 14px; background: var(--white);
    border: 1px solid var(--grey-cold); border-radius: 100px;
  }
  .hero-tag::before { content: '✓'; color: var(--gold); font-size: 10px; }
  .hero-tags { display: flex; flex-wrap: wrap; gap: 8px; }

  /* SECTIONS */
  section { padding: 96px 24px; }
  .container { max-width: 1200px; margin: 0 auto; }
  .section-label {
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); font-weight: 600; margin-bottom: 16px;
    display: flex; align-items: center; gap: 12px;
  }
  .section-label::before { content: ''; display: block; width: 24px; height: 1px; background: var(--gold); }
  .section-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(32px, 4vw, 52px); font-weight: 300; line-height: 1.15; color: var(--graphite); }
  .section-title em { font-style: italic; color: var(--gold); }

  /* ABOUT */
  .about { background: var(--white); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; margin-top: 64px; }
  .about-image-box { aspect-ratio: 4/5; background: var(--beige); border-radius: var(--radius-lg); overflow: hidden; position: relative; }
  .about-badge {
    position: absolute; bottom: -20px; right: -20px;
    background: var(--graphite); color: var(--white);
    padding: 20px 24px; border-radius: var(--radius-lg);
    text-align: center; box-shadow: var(--shadow-card);
  }
  .badge-num { font-family: 'Cormorant Garamond', serif; font-size: 38px; font-weight: 300; line-height: 1; color: var(--gold-light); }
  .badge-txt { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-top: 4px; }
  .about-image { position: relative; }
  .about-text { font-size: 15px; color: var(--grey-text); line-height: 1.9; margin: 20px 0 36px; font-weight: 300; }
  .about-feature { display: flex; align-items: flex-start; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--grey-cold); }
  .about-feature:first-child { border-top: 1px solid var(--grey-cold); }
  .feature-icon { width: 36px; height: 36px; background: var(--gold-pale); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 15px; }
  .feature-title { font-size: 13px; font-weight: 600; color: var(--graphite); margin-bottom: 2px; }
  .feature-desc { font-size: 12px; color: var(--grey-text); }

  /* SERVICES */
  .services { background: var(--milk); }
  .services-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; margin-bottom: 56px; }
  .services-intro-text { font-size: 15px; color: var(--grey-text); line-height: 1.8; font-weight: 300; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .service-card {
    background: var(--white); border: 1px solid rgba(201,169,110,0.15);
    padding: 32px 28px; border-radius: var(--radius-lg);
    cursor: pointer; transition: all .3s; position: relative; overflow: hidden;
  }
  .service-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--gold), transparent);
    opacity: 0; transition: opacity .3s;
  }
  .service-card:hover { box-shadow: var(--shadow-card); transform: translateY(-2px); border-color: rgba(201,169,110,0.3); }
  .service-card:hover::before { opacity: 1; }
  .service-icon { width: 44px; height: 44px; margin-bottom: 20px; color: var(--gold); }
  .service-category { font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 8px; }
  .service-name { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 400; color: var(--graphite); margin-bottom: 10px; line-height: 1.2; }
  .service-desc { font-size: 12px; color: var(--grey-text); line-height: 1.7; font-weight: 300; }
  .service-arrow { position: absolute; bottom: 20px; right: 24px; color: var(--grey-mid); font-size: 16px; transition: all .3s; }
  .service-card:hover .service-arrow { color: var(--gold); transform: translateX(4px); }

  /* ADVANTAGES */
  .advantages { background: var(--graphite); }
  .advantages .section-label { color: var(--gold-light); }
  .advantages .section-label::before { background: var(--gold-light); }
  .advantages .section-title { color: var(--white); }
  .advantages .section-title em { color: var(--gold-light); }
  .advantages-grid {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px;
    background: rgba(255,255,255,0.08); margin-top: 64px;
    border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-lg); overflow: hidden;
  }
  .adv-item { background: var(--graphite); padding: 40px 28px; text-align: center; transition: background .3s; }
  .adv-item:hover { background: rgba(201,169,110,0.08); }
  .adv-num { font-family: 'Cormorant Garamond', serif; font-size: 48px; font-weight: 300; color: var(--gold); line-height: 1; margin-bottom: 16px; }
  .adv-title { font-size: 12px; font-weight: 600; letter-spacing: 0.05em; color: var(--white); margin-bottom: 8px; }
  .adv-desc { font-size: 11px; color: rgba(255,255,255,0.4); line-height: 1.6; }

  /* PRICES */
  .prices { background: var(--white); }
  .prices-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; flex-wrap: wrap; gap: 24px; }
  .price-list { display: flex; flex-direction: column; }
  .price-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 0; border-bottom: 1px solid var(--grey-cold);
    gap: 16px; transition: all .2s; cursor: default;
  }
  .price-item:first-child { border-top: 1px solid var(--grey-cold); }
  .price-item:hover { padding-left: 8px; }
  .price-left { flex: 1; }
  .price-name { font-size: 14px; font-weight: 500; color: var(--graphite); margin-bottom: 3px; }
  .price-note { font-size: 11px; color: var(--grey-text); }
  .price-val { font-family: 'Cormorant Garamond', serif; font-size: 22px; font-weight: 400; color: var(--graphite); white-space: nowrap; flex-shrink: 0; }
  .price-currency { font-family: 'Manrope', sans-serif; font-size: 12px; color: var(--grey-text); font-weight: 400; }
  .price-note-bottom { margin-top: 24px; font-size: 11px; color: var(--grey-text); font-style: italic; text-align: center; }

  /* REVIEWS */
  .reviews { background: var(--milk); }
  .reviews-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px; flex-wrap: wrap; gap: 24px; }
  .rating-badge {
    display: flex; align-items: center; gap: 12px;
    background: var(--white); border: 1px solid rgba(201,169,110,0.2);
    padding: 16px 24px; border-radius: var(--radius-lg);
  }
  .rating-num { font-family: 'Cormorant Garamond', serif; font-size: 40px; font-weight: 300; line-height: 1; color: var(--graphite); }
  .rating-stars { color: var(--gold); font-size: 14px; letter-spacing: 2px; }
  .rating-count { font-size: 11px; color: var(--grey-text); margin-top: 2px; }
  .reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .review-card { background: var(--white); border: 1px solid rgba(201,169,110,0.12); padding: 28px; border-radius: var(--radius-lg); transition: box-shadow .3s; }
  .review-card:hover { box-shadow: var(--shadow-card); }
  .review-stars { color: var(--gold); font-size: 12px; letter-spacing: 2px; margin-bottom: 16px; }
  .review-text { font-size: 13px; color: var(--graphite-soft); line-height: 1.8; font-weight: 300; margin-bottom: 20px; font-style: italic; }
  .review-text::before { content: '\00AB'; }
  .review-text::after { content: '\00BB'; }
  .review-author { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--grey-cold); }
  .review-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--beige); display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--gold); font-weight: 600; flex-shrink: 0; }
  .review-name { font-size: 13px; font-weight: 600; color: var(--graphite); }
  .review-date { font-size: 10px; color: var(--grey-text); margin-top: 1px; }

  /* CONTACTS */
  .contacts { background: var(--white); }
  .contacts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; margin-top: 56px; align-items: start; }
  .contact-block { margin-bottom: 32px; }
  .contact-label { font-size: 9px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin-bottom: 8px; }
  .contact-value { font-size: 16px; color: var(--graphite); }
  .contact-value a { color: var(--graphite); text-decoration: none; transition: color .2s; }
  .contact-value a:hover { color: var(--gold); }
  .hours-grid { display: flex; flex-direction: column; gap: 6px; }
  .hours-row { display: flex; justify-content: space-between; font-size: 13px; padding-bottom: 6px; border-bottom: 1px solid var(--grey-cold); }
  .hours-row:last-child { border-bottom: none; }
  .hours-day { color: var(--grey-text); }
  .hours-time { font-weight: 500; color: var(--graphite); }
  .contact-ctas { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .btn-wa {
    background: #25D366; color: white;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 14px 28px; border-radius: var(--radius);
    font-size: 11px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
    text-decoration: none; transition: all .25s;
  }
  .btn-wa:hover { background: #1ebe5a; box-shadow: 0 4px 16px rgba(37,211,102,0.3); }
  .map-container { border-radius: var(--radius-lg); overflow: hidden; height: 400px; background: var(--beige); border: 1px solid var(--grey-cold); }
  .map-container iframe { width: 100%; height: 100%; border: none; }

  /* FOOTER */
  footer { background: var(--graphite); padding: 48px 24px; text-align: center; }
  .footer-inner { max-width: 1200px; margin: 0 auto; }
  .footer-logo { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 300; color: var(--white); letter-spacing: 0.08em; margin-bottom: 4px; }
  .footer-tagline { font-size: 10px; letter-spacing: 0.25em; color: var(--gold); text-transform: uppercase; margin-bottom: 28px; }
  .footer-links { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
  .footer-links a { font-size: 11px; color: rgba(255,255,255,0.4); text-decoration: none; letter-spacing: 0.1em; transition: color .2s; }
  .footer-links a:hover { color: var(--gold); }
  .footer-copy { font-size: 11px; color: rgba(255,255,255,0.2); }

  /* FAB */
  .fab-wa {
    position: fixed; bottom: 28px; right: 24px; z-index: 200;
    width: 56px; height: 56px; background: #25D366;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 20px rgba(37,211,102,0.4); cursor: pointer; transition: all .3s; text-decoration: none;
  }
  .fab-wa:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(37,211,102,0.5); }
  .fab-wa svg { width: 26px; height: 26px; fill: white; }

  /* ANIMATIONS */
  .fade-in { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  .fade-in.visible { opacity: 1; transform: translateY(0); }
  .stagger-1 { transition-delay: .1s; }
  .stagger-2 { transition-delay: .2s; }
  .stagger-3 { transition-delay: .3s; }
  .stagger-4 { transition-delay: .4s; }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .advantages-grid { grid-template-columns: repeat(3, 1fr); }
    .hero-inner { grid-template-columns: 1fr; gap: 48px; }
    .hero-right { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .hero-stats-row { display: contents; }
    .hero-tags { display: none; }
  }
  @media (max-width: 768px) {
    section { padding: 64px 20px; }
    nav { display: none; }
    .header-cta { display: none; }
    .burger { display: block; }
    .hero-inner { padding: 48px 20px 72px; grid-template-columns: 1fr; }
    .hero-title { font-size: clamp(42px, 12vw, 64px); }
    .hero-right { grid-template-columns: 1fr 1fr; }
    .about-grid { grid-template-columns: 1fr; gap: 48px; }
    .about-badge { bottom: -16px; right: 16px; }
    .services-intro { grid-template-columns: 1fr; gap: 24px; }
    .advantages-grid { grid-template-columns: repeat(2, 1fr); }
    .adv-item:last-child { grid-column: 1/-1; }
    .reviews-grid { grid-template-columns: 1fr; }
    .contacts-grid { grid-template-columns: 1fr; gap: 40px; }
    .prices-header { flex-direction: column; align-items: flex-start; }
    .reviews-header { flex-direction: column; align-items: flex-start; }
    .fab-wa { bottom: 20px; right: 16px; }
  }
  @media (max-width: 480px) {
    .hero-right { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn { width: 100%; text-align: center; }
    .advantages-grid { grid-template-columns: 1fr; }
    .adv-item:last-child { grid-column: auto; }
    .services-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-in { opacity: 1; transform: none; transition: none; }
  }
</style>
</head>
<body>

<div class="mobile-menu" id="mobileMenu">
  <a href="#about" onclick="closeMobileMenu()">О клинике</a>
  <a href="#services" onclick="closeMobileMenu()">Услуги</a>
  <a href="#prices" onclick="closeMobileMenu()">Цены</a>
  <a href="#reviews" onclick="closeMobileMenu()">Отзывы</a>
  <a href="#contacts" onclick="closeMobileMenu()">Контакты</a>
  <a href="https://wa.me/73852000000" class="btn btn-gold" style="font-size:11px;padding:14px 32px;">Записаться</a>
</div>

<header id="header">
  <div class="header-inner">
    <a href="#" class="logo">
      <span class="logo-main">Ю Skin Clinic</span>
      <span class="logo-sub">Барнаул · Косметология</span>
    </a>
    <nav>
      <a href="#about">О клинике</a>
      <a href="#services">Услуги</a>
      <a href="#prices">Цены</a>
      <a href="#reviews">Отзывы</a>
      <a href="#contacts">Контакты</a>
    </nav>
    <a href="https://wa.me/73852000000" class="btn btn-gold nav-cta header-cta">Записаться</a>
    <button class="burger" id="burgerBtn" onclick="toggleMenu()" aria-label="Меню">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<section class="hero" id="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
